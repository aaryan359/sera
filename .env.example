# Local Docker Compose defaults. Copy only the values you want to override into .env.
# These credentials are for local development; choose a different password for any hosted setup.
POSTGRES_USER=sera
POSTGRES_PASSWORD=sera_local_only
POSTGRES_DB=sera
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
ADMINER_HOST_PORT=18080

# Self-hosted search (SearXNG). Replace the secret with a random string, e.g. openssl rand -hex 32.
SEARXNG_HOST_PORT=18888
SEARXNG_SECRET=replace-with-a-random-string
# Where the backend reaches SearXNG. Defaults to http://127.0.0.1:SEARXNG_HOST_PORT if unset.
SEARXNG_URL=http://127.0.0.1:18888

# Greenhouse job boards to search (comma-separated board tokens, e.g. stripe,airbnb). Empty = no job search.
GREENHOUSE_BOARDS=

# URLs for a backend process running on your host (not inside Docker).
# If you change the values above, update DATABASE_URL as well.
DATABASE_URL=postgresql://sera:sera_local_only@127.0.0.1:15432/sera
REDIS_URL=redis://127.0.0.1:16379
