{
  "expo": {
    "name": "sera",
    "slug": "sera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/sera-icon.png",
    "scheme": "sera",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/sera-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F6EE",
        "foregroundImage": "./assets/branding/sera-adaptive.png",
        "monochromeImage": "./assets/branding/sera-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.sera"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/branding/sera-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6EE",
          "image": "./assets/branding/sera-wordmark.png",
          "imageWidth": 156
        }
      ],
      "react-native-liquid-glassmorphism"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
